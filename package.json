{
  "name": "shader-ambient",
  "version": "0.1.0",
  "description": "Zero-dependency WebGL ambient background: flickering grid, mouse-follow ripple field and floating particles in one raw fragment shader — with full performance guards (DPR cap, offscreen pause, reduced-motion, static-frame mode).",
  "keywords": [
    "webgl",
    "shader",
    "background",
    "ambient",
    "cyberpunk",
    "grid",
    "particles",
    "react",
    "canvas"
  ],
  "license": "MIT",
  "author": "ShaderAmbient Authors",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js",
      "require": "./dist/core.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "peerDependencies": {
    "react": ">=17"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "react": "^18.3.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
